# FireLearn environment variables
# Copy to .env.local for local development. Never commit real secrets.

# Browser-safe Supabase values. These may be exposed to client code.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Server-only Supabase values. Never expose these to client components.
SUPABASE_SECRET_KEY="sb_secret_..."

# Server-only Postgres connection strings for migrations/admin jobs.
POSTGRES_URL="postgres://..."
POSTGRES_URL_NON_POOLING="postgres://..."
POSTGRES_PRISMA_URL="postgres://..."
